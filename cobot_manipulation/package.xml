<?xml version="1.0"?>
<package format="3">
  <name>cobot_manipulation</name>
  <version>0.1.0</version>
  <description>MoveIt pick and place coordinator for the Cobot 280 simulation.</description>
  <maintainer email="grownuphoon@gmail.com">vibhu</maintainer>
  <license>BSD-3-Clause</license>
  <buildtool_depend>ament_python</buildtool_depend>
  <exec_depend>rclpy</exec_depend>
  <exec_depend>geometry_msgs</exec_depend>
  <exec_depend>shape_msgs</exec_depend>
  <exec_depend>moveit_msgs</exec_depend>
  <exec_depend>control_msgs</exec_depend>
  <exec_depend>std_srvs</exec_depend>
  <exec_depend>action_msgs</exec_depend>
  <exec_depend>cobot_perception</exec_depend>
  <export><build_type>ament_python</build_type></export>
</package>
