<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro">

  <xacro:macro name="intel_rgbd_cam_d435" params="parent prefix use_gazebo *origin">

    <xacro:property name="M_PI" value="3.1415926535897931" />

    <xacro:property name="d435_cam_width" value="0.090"/>
    <xacro:property name="d435_cam_height" value="0.025"/>
    <xacro:property name="d435_cam_depth" value="0.02505"/>

    <xacro:property name="d435_cam_depth_to_infra1_offset" value="0.0"/>
    <xacro:property name="d435_cam_depth_to_infra2_offset" value="-0.050"/>
    <xacro:property name="d435_cam_depth_to_color_offset" value="0.015"/>

    <xacro:property name="camera_tilt_angle_deg" value="25"/>

    <link name="${prefix}camera_head_link">
      <visual>
        <origin xyz="0 0 0" rpy="${M_PI/2} 0.0 ${M_PI/2}"/>
        <geometry>
          <mesh filename="file://$(find cobot_description)/meshes/d435/visual/d435.stl" />
        </geometry>
        <material name="aluminum">
          <color rgba="0.5 0.5 0.5 1"/>
        </material>
      </visual>
      <collision>
        <origin xyz="0 0 0" rpy="0 0 0"/>
        <geometry>
          <box size="${d435_cam_depth} ${d435_cam_width} ${d435_cam_height}"/>
        </geometry>
      </collision>
      <inertial>
        <mass value="0.072" />
        <origin xyz="0 0 0" />
        <inertia ixx="0.003881243" ixy="0.0" ixz="0.0" iyy="0.000498940" iyz="0.0" izz="0.003879257" />
      </inertial>
    </link>

    <joint name="${prefix}camera_head_joint" type="fixed">
      <xacro:insert_block name="origin"/>
      <parent link="${prefix}${parent}"/>
      <child link="${prefix}camera_head_link"/>
    </joint>

    <joint name="${prefix}camera_head_depth_joint" type="fixed">
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <parent link="${prefix}camera_head_link"/>
      <child link="${prefix}camera_head_depth_frame" />
    </joint>
    <link name="${prefix}camera_head_depth_frame"/>

    <joint name="${prefix}camera_head_depth_optical_joint" type="fixed">
      <origin xyz="0 0 0" rpy="${-M_PI/2} 0 ${-M_PI/2}" />
      <parent link="${prefix}camera_head_depth_frame" />
      <child link="${prefix}camera_head_depth_optical_frame" />
    </joint>
    <link name="${prefix}camera_head_depth_optical_frame"/>

    <joint name="${prefix}camera_head_infra1_joint" type="fixed">
      <origin xyz="0 ${d435_cam_depth_to_infra1_offset} 0" rpy="0 0 0" />
      <parent link="${prefix}camera_head_link" />
      <child link="${prefix}camera_head_infra1_frame" />
    </joint>
    <link name="${prefix}camera_head_infra1_frame"/>

    <joint name="${prefix}camera_head_infra1_optical_joint" type="fixed">
      <origin xyz="0 0 0" rpy="${-M_PI/2} 0 ${-M_PI/2}" />
      <parent link="${prefix}camera_head_infra1_frame" />
      <child link="${prefix}camera_head_infra1_optical_frame" />
    </joint>
    <link name="${prefix}camera_head_infra1_optical_frame"/>

    <joint name="${prefix}camera_head_infra2_joint" type="fixed">
      <origin xyz="0 ${d435_cam_depth_to_infra2_offset} 0" rpy="0 0 0" />
      <parent link="${prefix}camera_head_link" />
      <child link="${prefix}camera_head_infra2_frame" />
    </joint>
    <link name="${prefix}camera_head_infra2_frame"/>

    <joint name="${prefix}camera_head_infra2_optical_joint" type="fixed">
      <origin xyz="0 0 0" rpy="${-M_PI/2} 0 ${-M_PI/2}" />
      <parent link="${prefix}camera_head_infra2_frame" />
      <child link="${prefix}camera_head_infra2_optical_frame" />
    </joint>
    <link name="${prefix}camera_head_infra2_optical_frame"/>

    <joint name="${prefix}camera_head_color_joint" type="fixed">
      <origin xyz="0 ${d435_cam_depth_to_color_offset} 0" rpy="0 0 0" />
      <parent link="${prefix}camera_head_link" />
      <child link="${prefix}camera_head_color_frame" />
    </joint>
    <link name="${prefix}camera_head_color_frame"/>

    <joint name="${prefix}camera_head_color_optical_joint" type="fixed">
      <origin xyz="0 0 0" rpy="${-M_PI/2} 0 ${-M_PI/2}" />
      <parent link="${prefix}camera_head_color_frame" />
      <child link="${prefix}camera_head_color_optical_frame" />
    </joint>
    <link name="${prefix}camera_head_color_optical_frame"/>

    <xacro:if value="${use_gazebo}">
    <gazebo reference="${prefix}camera_head_link">
      <sensor name="camera_head" type="rgbd_camera">
        <camera>
          <horizontal_fov>1.5184</horizontal_fov>
          <image>
            <width>424</width>
            <height>240</height>
          </image>
          <clip>
            <near>0.05</near>
            <far>1.5</far>
          </clip>
        </camera>
        <always_on>1</always_on>
        <!-- RGB-D pixels use optical coordinates (x right, y down, z forward). -->
        <gz_frame_id>${prefix}camera_head_color_optical_frame</gz_frame_id>
        <topic>/camera_head</topic>
        <update_rate>5</update_rate>
        <visualize>true</visualize>
      </sensor>
    </gazebo>
    </xacro:if>

  </xacro:macro>
</robot>
